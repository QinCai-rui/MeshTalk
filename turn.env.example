# Copy to .env and replace the example values before starting Compose.
# Choose exactly one TURN provider below.
# Uncomment what you need.

#CONTROL_TURN_PROVIDER=coturn

# Self-hosted coturn
#TURN_SHARED_SECRET=replace-with-output-of-openssl-rand-base64-32
#TURN_REALM=turn.example.com
#TURN_URIS=turn:turn.example.com:3478?transport=udp
#TURN_EXTERNAL_IP=203.0.113.1
#TURN_PORT=3478
#TURN_RELAY_MIN_PORT=49152
#TURN_RELAY_MAX_PORT=49200

# Cloudflare Realtime TURN
# Set CONTROL_TURN_PROVIDER=cloudflare above, fill these values, and start only
# the control service: docker compose --env-file .env up -d control
# Do NOT put the Cloudflare API token in any client environment.
# CONTROL_CLOUDFLARE_TURN_TOKEN_ID=replace-with-cloudflare-turn-token-id
# CONTROL_CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
# CONTROL_TURN_TTL_SECONDS=600
