FROM oven/bun:alpine AS bun-build

ARG TARGETPLATFORM
WORKDIR /app

COPY package.json bun.lock* ./
COPY tui/package.json tui/
COPY cli/package.json cli/
COPY control/package.json control/
COPY common/ common/
RUN bun install --frozen-lockfile 2>/dev/null || bun install

COPY tui/ tui/
COPY cli/ cli/

RUN BUN_TARGET="bun"; \
    case "${TARGETPLATFORM}" in \
      linux/amd64)  BUN_TARGET="bun-linux-x64" ;; \
      linux/arm64)  BUN_TARGET="bun-linux-arm64" ;; \
    esac; \
    bun build tui/src/index.tsx \
      --target=${BUN_TARGET} \
      --compile \
      --define 'process.env.OPENTUI_LIBC="glibc"' \
      --outfile /app/meshtalk-tui && \
    bun build cli/src/index.ts \
      --target=${BUN_TARGET} \
      --compile \
      --outfile /app/meshtalk-cli

FROM python:3.12-slim AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl binutils && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/ backend/

RUN pip install --no-cache-dir hatchling && \
    pip install --no-cache-dir ./backend && \
    pip install --no-cache-dir pyinstaller && \
    cd backend && \
    pyinstaller \
      --noconfirm \
      --onefile \
      --name meshtalk-backend \
      --distpath /app/binaries \
      --workpath /tmp/pyinstaller-build \
      --specpath /tmp \
      meshtalk_launcher.py && \
    cd /app && \
    pip uninstall -y pyinstaller hatchling && \
    rm -rf /tmp/pyinstaller-build /app/backend

COPY --from=bun-build /app/meshtalk-tui /usr/local/bin/meshtalk-tui
COPY --from=bun-build /app/meshtalk-cli /usr/local/bin/meshtalk-cli
RUN cp /app/binaries/meshtalk-backend /usr/local/bin/meshtalk-backend && \
    rm -rf /app/binaries

COPY docker/entrypoint-client.sh /usr/local/bin/entrypoint-client.sh
RUN chmod +x /usr/local/bin/entrypoint-client.sh

RUN useradd -m -s /bin/sh meshtalk && \
    mkdir -p /data/meshtalk && \
    chown -R meshtalk:meshtalk /data/meshtalk

USER meshtalk
ENV HOME=/home/meshtalk

VOLUME ["/data/meshtalk"]

ENTRYPOINT ["entrypoint-client.sh"]
