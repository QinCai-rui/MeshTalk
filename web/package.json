{
  "name": "meshtalk-website",
  "version": "1.0.0",
  "private": true,
  "description": "MeshTalk official website",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:css && node build.js && node sitemap.js",
    "build:sitemap": "node sitemap.js",
    "build:css": "tailwindcss -i public/css/src.css -o public/css/style.css --minify",
    "watch:css": "tailwindcss -i public/css/src.css -o public/css/style.css --watch",
    "start": "npm run build && node server.js",
    "dev": "concurrently \"npm run watch:css\" \"node server.js\""
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-handlebars": "^8.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  }
}
