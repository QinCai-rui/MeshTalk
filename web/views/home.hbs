<script>
  (async () => {
    const REPO_URL = "https://api.github.com/repos/QinCai-rui/MeshTalk/releases/latest";
    const RELEASES_BASE = "https://github.com/QinCai-rui/MeshTalk/releases/tag";

    try {
      const res = await fetch(REPO_URL);
      if (!res.ok) return;
      const data = await res.json();
      const tag = data.tag_name;
      if (!tag) return;

      const badge = document.getElementById("version-badge");
      if (badge) badge.textContent = tag;

      const releaseUrl = `${RELEASES_BASE}/${tag}`;
      document.getElementById("dl-macos")?.setAttribute("href", releaseUrl);
      document.getElementById("dl-linux")?.setAttribute("href", releaseUrl);
      document.getElementById("dl-windows")?.setAttribute("href", releaseUrl);
    } catch {}
  })();
</script>
