<section class="section">
  <div class="container">
    <div class="head head--split">
      <div>
        <p class="kicker">Getting started</p>
        <h1 class="h2">Running in a couple of minutes.</h1>
      </div>
      <p class="head__note">One command to install, one to launch. Peers on your network show up on their own.</p>
    </div>

    <div class="doc-layout">
      <nav class="doc-nav" aria-label="On this page">
        <a href="#install" class="is-active">Install</a>
        <a href="#quick-start">Quick start</a>
        <a href="#remote">Remote setup</a>
