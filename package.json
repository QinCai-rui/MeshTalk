{
  "name": "meshtalk",
  "version": "0.23.0",
  "private": true,
  "workspaces": ["tui", "cli", "control"],
  "bin": {
    "meshtalk": "bin/meshtalk.ts"
  },
  "scripts": {
    "meshtalk": "bun run ./bin/meshtalk.ts",
    "dev:tui": "bun run --filter meshtalk-tui dev",
    "dev:cli": "bun run --filter meshtalk-cli dev",
    "dev:control": "bun run --filter meshtalk-control dev",
    "build": "bun run --filter '*' build"
  },
  "dependencies": {
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "react-devtools-core": "^7.0.1",
    "web-tree-sitter": "^0.27.0"
  }
}
