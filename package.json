{
  "name": "meshtalk",
  "version": "0.32.3",
  "private": true,
  "workspaces": ["tui", "cli", "control", "desktop"],
  "bin": {
    "meshtalk": "bin/meshtalk.ts"
  },
  "scripts": {
    "dev:desktop": "bun run --cwd desktop dev",
    "build:desktop": "bun run --cwd desktop package",
    "meshtalk": "bun run ./bin/meshtalk.ts",
    "dev:tui": "bun run --filter meshtalk-tui dev",
    "dev:cli": "bun run --filter meshtalk-cli dev",
    "dev:control": "bun run --filter meshtalk-control dev",
    "build": "bun run --filter '*' build"
  },
  "dependencies": {
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "react": "^19.2.8",
    "web-tree-sitter": "0.25.10"
  }
}
